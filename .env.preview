# -------------------------------------------
#                                           |
#           针对【预览】环境的配置            |
#                                           |
# -------------------------------------------
# 预览态：用生产构建产物 + mock 服务，
# 不依赖任何后端。mock 由 vite preview 服务端中间件接管，
# 因此仅 `pnpm preview` 本地生效，产物直接托管到 nginx 不会带 mock。

# 代理前缀（接口 URL 与 mock 定义都用它拼接）
VITE_APP_BASE_API=/admin-api/v1

# 接口地址
# preview 服务不转发接口，未被 mock 命中的请求才会走到这里，作兜底
VITE_APP_API_URL=http://localhost:9421

# WebSocket端点(可选)
# mock 不接管 ws，此处连不上不影响 HTTP 接口
VITE_APP_WS_ENDPOINT=ws://localhost:9421/admin-api/v1/websocket

# 启用 Mock 服务(true:开启 false:关闭)
VITE_MOCK_DEV_SERVER=true

# 是否启用开发者模式 (显示所有菜单项，不限制按钮权限)
VITE_ENABLE_DEV_MODE=false
