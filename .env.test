# -------------------------------------------
#                                           |
#            针对【联调】环境的配置           |
#                                           |
# -------------------------------------------

# 代理前缀
VITE_APP_BASE_API=/admin-api/v1

# 接口地址
# 联调环境不启用 mock，请求由 vite 代理转发到本地后端
VITE_APP_API_URL=http://localhost:9421

# WebSocket端点(可选)
VITE_APP_WS_ENDPOINT=ws://localhost:9421/admin-api/v1/websocket

# 启用 Mock 服务(true:开启 false:关闭)
VITE_MOCK_DEV_SERVER=false

# 是否启用开发者模式 (显示所有菜单项，不限制按钮权限)
VITE_ENABLE_DEV_MODE=false
